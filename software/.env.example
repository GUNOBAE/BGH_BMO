# Template only. The app reads exported environment variables, not dotenv files.
# Keep your real key out of Git, terminal transcripts and shell history.
OPENAI_API_KEY=YOUR_KEY_HERE
BMO_CHAT_MODEL=gpt-4.1-mini
BMO_STT_MODEL=gpt-4o-mini-transcribe
BMO_TTS_MODEL=gpt-4o-mini-tts
BMO_VOICE=coral
BMO_LANGUAGE=en
BMO_SECONDS=5
BMO_TIMEOUT=30
BMO_MAX_RETRIES=1
BMO_MAX_TURNS=8
BMO_MAX_INPUT_CHARS=4000
BMO_MAX_HISTORY_CHARS=16000
BMO_MAX_OUTPUT_TOKENS=180
BMO_LOG_LEVEL=INFO
# Optional rotating event log; excludes transcripts, audio and API keys.
# BMO_LOG_FILE=/home/bgh/BGH_BMO/software/logs/events.jsonl
# Omit these to retain existing ALSA defaults. Discover first: --list-audio
# Observed card identifiers on this Pi; capture/playback remain untested.
# BMO_MIC_DEVICE=plughw:CARD=Device,DEV=0
# BMO_SPEAKER_DEVICE=plughw:CARD=MAX98357A,DEV=0

# Optional Fish Audio Aaron BMO voice (API charges are separate from OpenAI).
# Default stays OpenAI voice unless explicitly selected.
# FISH_API_KEY=YOUR_FISH_API_KEY  # export interactively; NEVER commit a real key
BMO_TTS_PROVIDER=openai
BMO_FISH_MODEL=s2.1-pro-free
BMO_FISH_VOICE_ID=106f41ea392c4cc48c6eee76f69ff17e
# Available paid Fish models: s2.1-pro, drama-3
